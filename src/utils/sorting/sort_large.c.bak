#include "../push_swap.h"

// Find the closest number in the chunk from top or bottom
static t_stack *find_closest_in_chunk(t_stack *a, int chunk_max)
{
    t_stack *closest = a;
    int min_moves = a->index;
    t_stack *current = a;
    int i = 0;

    while (current)
    {
        if (current->value <= chunk_max)
        {
            if (i < min_moves)
            {
                min_moves = i;
                closest = current;
            }
        }
        current = current->next;
        i++;
    }
    return closest;
}

// Push numbers to stack_b in adaptive chunks
static void push_to_b_chunks(t_stack **a, t_stack **b, int total_size)
{
    int chunk_count = 5; // Dynamically adjust chunk count
    int chunk_size = total_size / chunk_count;
    int chunk_max = chunk_size;

    while (*a)
    {
        t_stack *closest = find_closest_in_chunk(*a, chunk_max);
        
        while (*a != closest)
        {
            if (closest->index < ft_lstsize_ps(*a) / 2)
                ra(a);
            else
                rra(a);
        }

        pb(b, a);
        if (*b && (*b)->value < chunk_max - (chunk_size / 2))
            rb(b); // Keep lower values near the bottom
        
        if (ft_lstsize_ps(*b) >= chunk_max)
            chunk_max += chunk_size;
    }
}

// Move the largest number in stack_b to the top before pushing to stack_a
static void push_back_to_a(t_stack **a, t_stack **b)
{
    while (*b)
    {
        t_stack *largest = *b;
        int max_index = 0;
        int i = 0;
        t_stack *current = *b;

        while (current)
        {
            if (current->value > largest->value)
            {
                largest = current;
                max_index = i;
            }
            current = current->next;
            i++;
        }

        while (*b != largest)
        {
            if (max_index < ft_lstsize_ps(*b) / 2)
                rb(b);
            else
                rrb(b);
        }
        pa(a, b);
    }
}

// Rotate stack_a so the smallest element is at the top
static void adjust_stack_a(t_stack **a)
{
    t_stack *current = *a;
    t_stack *min_node = current;
    int min_index = 0;
    int i = 0;

    while (current)
    {
        if (current->value < min_node->value)
        {
            min_node = current;
            min_index = i;
        }
        current = current->next;
        i++;
    }

    int size = ft_lstsize_ps(*a);
    while (*a != min_node)
    {
        if (min_index < size / 2)
            ra(a);
        else
            rra(a);
    }
}

// Main sorting function for large numbers
void sort_large(t_stack **a, t_stack **b)
{
    int size = ft_lstsize_ps(*a);
    
    if (size <= 3)
    {
        sort_small(a, b);
        return;
    }

    push_to_b_chunks(a, b, size); // Move numbers to stack_b in optimized chunks
    sort_small(a, b);             // Sort remaining three numbers
    push_back_to_a(a, b);         // Return sorted numbers to stack_a
    adjust_stack_a(a);            // Final adjustment to align the smallest number
}
